# All live integrations are disabled until explicitly configured.
# Use provider secret managers or .env.local; never paste secrets into source.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Server-only restricted PostgreSQL login created by scripts/setup-database.mjs.
# For Vercel use the Supabase session/transaction pooler if IPv6 is unavailable.
DATABASE_URL=
# Local migration/admin use only. Never configure this as a public variable.
CASHY_MIGRATION_DATABASE_URL=
